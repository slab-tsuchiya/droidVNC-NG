<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard-shortcut settings rows, inflated into InputKeyShortcutSetupView (a
     TableLayout). A bold heading row plus one row per configurable action: three
     modifier checkboxes (Ctrl/Alt/Shift) and a trigger-key spinner. The spinner
     entries and their wiring are set up in InputKeyShortcutSetupView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:padding="10dp"
            android:text="@string/main_activity_settings_key_shortcuts"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_column="0"
            android:layout_gravity="center_vertical"
            android:padding="10dp"
            android:hyphenationFrequency="full"
            android:text="@string/main_activity_settings_chord_recents" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_gravity="center_vertical"
            android:padding="10dp"
            android:text="@string/main_activity_colon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="2"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <CheckBox
                android:id="@+id/settings_chord_recents_ctrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_modifier_ctrl" />

            <CheckBox
                android:id="@+id/settings_chord_recents_alt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_modifier_alt" />

            <CheckBox
                android:id="@+id/settings_chord_recents_shift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_modifier_shift" />

            <Spinner
                android:id="@+id/settings_chord_recents_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="3dp" />
        </LinearLayout>
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_column="0"
