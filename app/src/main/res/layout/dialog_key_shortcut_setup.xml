<?xml version="1.0" encoding="utf-8"?>
<!-- Content of the full-screen keyboard-shortcut dialog opened from MainActivity: a heading, the
     scrollable InputKeyShortcutSetupView rows, and a Done button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/main_activity_settings_key_shortcuts"
        android:textAppearance="@style/TextAppearance.AppCompat.Large" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <net.christianbeier.droidvnc_ng.InputKeyShortcutSetupView
            android:id="@+id/key_shortcut_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <Button
        android:id="@+id/key_shortcut_setup_done"
        style="@style/MainButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="@android:string/ok" />

</LinearLayout>
